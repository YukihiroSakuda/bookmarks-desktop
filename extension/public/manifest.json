{
  "manifest_version": 3,
  "name": "Bookmarks",
  "version": "0.1.0",
  "description": "Save bookmarks to your Bookmarks app with one click",
  "key": "",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["http://localhost:37373/*"],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
