{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "bookmarks",
  "version": "0.1.3",
  "identifier": "com.yukihirosakuda.bookmarks",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- -p 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Bookmarks",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Yukihiro Sakuda",
    "copyright": "Copyright © 2026 Yukihiro Sakuda",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
